{
  "name": "leadclaw-mcp",
  "version": "0.4.0",
  "description": "LeadClaw MCP server — book sales appointments via Claude",
  "type": "module",
  "bin": {
    "leadclaw-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "v2": "node --env-file-if-exists=.env dist/v2/server.js",
    "admin": "node --env-file-if-exists=.env dist/admin/cli.js",
    "webhook": "node --env-file-if-exists=.env dist/stripe/webhook.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "googleapis": "^172.0.0",
    "stripe": "^22.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
