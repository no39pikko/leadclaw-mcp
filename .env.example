# LeadClaw 環境変数テンプレート
# このファイルをコピーして .env にリネームし、値を埋めてください
# cp .env.example .env

# Stripe APIキー（Stripeダッシュボード → 開発者 → APIキー）
# テスト環境: sk_test_... / 本番環境: sk_live_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook署名シークレット
# ローカル開発: stripe listen コマンドの出力から取得
# 本番: Stripeダッシュボード → 開発者 → Webhooks → エンドポイント詳細
STRIPE_WEBHOOK_SECRET=whsec_...

# Webhookサーバのポート（デフォルト: 3001）
# PORT=3001
