# LeadClaw / GTM Agent — environment template
# Copy to .env and fill in. Nothing here is required to run in MOCK mode.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Driver mode
# ---------------------------------------------------------------------------
# mock  = force every driver to its mock (keyless end-to-end demo)
# live  = prefer live drivers; fall back to mock when a driver's keys are absent
# (unset / auto) = same as live
DRIVER_MODE=mock

# v2 HTTP server port (default 4000)
# PORT=4000

# Admin web UI password (if unset, /admin is open in local dev)
# ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Ad platform — Meta Lead Ads (v1 default AdDriver). Enables: ad launch + lead webhook.
# ---------------------------------------------------------------------------
# Graph API token with ads_management + leads_retrieval on your ad account/page.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Token you choose; must match what you set in the Meta webhook config.
META_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# AI voice calls — Retell (CallDriver). Enables: real outbound AI calls.
# ---------------------------------------------------------------------------
RETELL_API_KEY=
RETELL_AGENT_ID=
# A Twilio number connected to Retell, in E.164 (e.g. +12125550123).
RETELL_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Lead enrichment — Apollo (EnrichDriver).
# ---------------------------------------------------------------------------
APOLLO_API_KEY=

# ---------------------------------------------------------------------------
# Phone scrub — Twilio Lookup (ScrubDriver).
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# CRM — Notion (CrmDriver). The DB needs properties:
#   Name(title), Company(rich_text), Phone(phone_number), Email(email),
#   Outcome(rich_text), Meeting(date)
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_LEADS_DB_ID=

# ---------------------------------------------------------------------------
# Calendar — Google Calendar (CalendarDriver). After filling these, run:
#   npm run admin google-auth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Billing — Stripe (credit top-ups).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
