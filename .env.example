# LeadClaw 環境変数テンプレート
# このファイルをコピーして .env にリネームし、値を埋めてください
# cp .env.example .env

# Stripe APIキー（Stripeダッシュボード → 開発者 → APIキー）
# テスト環境: sk_test_... / 本番環境: sk_live_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook署名シークレット
# ローカル開発: stripe listen コマンドの出力から取得
# 本番: Stripeダッシュボード → 開発者 → Webhooks → エンドポイント詳細
STRIPE_WEBHOOK_SECRET=whsec_...

# Webhookサーバのポート（デフォルト: 3001）
# PORT=3001

# Google Calendar API（E-5 オプション機能）
# 取得方法: https://console.cloud.google.com/
#   1. プロジェクト作成 → APIとサービス → ライブラリ → Google Calendar API を有効化
#   2. 認証情報 → OAuthクライアントID作成（種類: デスクトップアプリ）
#   3. リダイレクトURI: http://localhost:3002/oauth2callback を追加
#   4. クライアントID・シークレットを以下に記入
#   5. npm run admin google-auth を実行してブラウザ認証
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
