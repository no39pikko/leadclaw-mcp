# LeadClaw / GTM Agent — environment template
# Copy to .env and fill in. Nothing here is required to run in MOCK mode.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Driver mode
# ---------------------------------------------------------------------------
# mock  = force every driver to its mock (keyless end-to-end demo)
# live  = prefer live drivers; fall back to mock when a driver's keys are absent
# (unset / auto) = same as live
DRIVER_MODE=mock

# v2 HTTP server port (default 4000)
# PORT=4000

# Public base URL of this server — used for OAuth redirects and lead webhooks.
# In prod set your https domain; locally use an ngrok/tunnel URL.
# PUBLIC_URL=https://your-domain.com

# Admin web UI password (if unset, /admin is open in local dev)
# ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Ad platform — Meta Lead Ads (v1 default AdDriver). Two modes:
#
# (A) Multi-tenant (service): customers connect their OWN ad account via OAuth.
#     Set the app credentials below; customers use the connect_ad_account tool.
META_APP_ID=
META_APP_SECRET=
#
# (B) Single-tenant (dogfood): run everything on ONE ad account with a long-lived
#     token. Set these and skip OAuth.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
#
# Webhook verification token you choose; must match the Meta webhook config.
META_VERIFY_TOKEN=
#
# Ad creation (launch_campaign): a creative image hash (upload one image to the
# ad account once, use its hash), your privacy policy URL (required by Meta lead
# forms), and optionally create ads PAUSED instead of going live immediately.
META_AD_IMAGE_HASH=
META_PRIVACY_URL=
# META_LAUNCH_PAUSED=true

# ---------------------------------------------------------------------------
# AI voice calls — Retell (CallDriver). Enables: real outbound AI calls.
# ---------------------------------------------------------------------------
RETELL_API_KEY=
RETELL_AGENT_ID=
# A Twilio number connected to Retell, in E.164 (e.g. +12125550123).
RETELL_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Lead enrichment — Apollo (EnrichDriver).
# ---------------------------------------------------------------------------
APOLLO_API_KEY=

# ---------------------------------------------------------------------------
# Phone scrub — Twilio Lookup (ScrubDriver).
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# CRM — Notion (CrmDriver). The DB needs properties:
#   Name(title), Company(rich_text), Phone(phone_number), Email(email),
#   Outcome(rich_text), Meeting(date)
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_LEADS_DB_ID=

# ---------------------------------------------------------------------------
# Calendar — Google Calendar (CalendarDriver). After filling these, run:
#   npm run admin google-auth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Ad platform — Google Ads (AdDriver). Reuses GOOGLE_CLIENT_ID/SECRET above
# (add the redirect URI PUBLIC_URL/connect/google/callback to that OAuth client).
# Customers connect their own Google Ads account; Google bills them directly for
# spend. No region block like Meta for Developers. Get a developer token in the
# Google Ads UI (Tools → API Center).
# ---------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
# Only if you operate via a manager (MCC) account:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Create ads PAUSED instead of going live immediately:
# LAUNCH_PAUSED=true

# ---------------------------------------------------------------------------
# Billing — Stripe (credit top-ups).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
